// The doorbell: one invocation polls a flag in CPU-visible memory written by the CPU, and answers each round with an ack.
// Layout (uint index): 0 = flag written by the CPU, 16 = ack written by the GPU, 32 = "started" marker.
// The poll count is capped per round, so a stalled CPU ends the shader well inside the 2 s display timeout.
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) coherent volatile buffer Mb { uint d[]; } mb;
layout(push_constant) uniform PC { uint rounds; uint max_polls; } pc;
void main() {
    mb.d[32] = 1u;
    memoryBarrierBuffer();
    for (uint k = 1u; k <= pc.rounds; ++k) {
        uint polls = 0u;
        while (mb.d[0] != k) {
            polls += 1u;
            if (polls > pc.max_polls) {
                mb.d[16] = 0xFFFFFFFFu;
                memoryBarrierBuffer();
                return;
            }
        }
        mb.d[16] = k;
        memoryBarrierBuffer();
    }
}
